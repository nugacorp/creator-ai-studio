# Creator AI Studio — environment example
# Copy to .env and fill in local values. Do NOT commit real secrets.

# --- API (apps/api) ---
API_PORT=3000
API_HOST=0.0.0.0
LOCAL_STORAGE_PATH=/data/episodes

# --- Auth (optional) ---
# CAS_API_KEY=your-secret-api-key  # Required for worker when Supabase JWT auth is enabled
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret  # Project Settings → API → JWT Secret

# --- Supabase Auth (web login + optional Postgres sync) ---
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Secrets encryption (required for UI API key storage) ---
# CAS_SECRETS_KEY=your-32-char-minimum-master-key-for-encrypting-stored-keys

# --- AI Providers (at least one recommended) ---
AI_PROVIDER_DEFAULT=gemini
# AI_SCRIPT_PROVIDER=openai
# AI_IMAGE_PROVIDER=gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# AI_FALLBACK_ENABLED=true
# AI_FALLBACK_ORDER=gemini,openai,claude
# AI_ALLOW_DEMO_FALLBACK=false

# --- Mock policy (FASE 8) ---
# true = allow demo/mock behavior (dev only). false = block everywhere.
# Unset: allowed in dev/test, BLOCKED automatically in NODE_ENV=production.
# ALLOW_MOCKS=false

# --- Episode metadata (FASE 9) ---
# filesystem | supabase | hybrid
# EPISODE_METADATA_SOURCE=filesystem

# --- Google OAuth (Gemini + YouTube desde Configuración) ---
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# CAS_PUBLIC_URL=https://creator-ai-studio.217.76.56.66.sslip.io

# --- External Integrations (optional) ---
# YOUTUBE_CLIENT_ID=
# YOUTUBE_ACCESS_TOKEN=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# PIPER_BIN=/usr/local/bin/piper
# PIPER_MODEL=/path/to/voice.onnx
# WEBHOOK_URL=https://your-webhook.example.com/events

# --- Archive (optional) ---
# RCLONE_REMOTE=gdrive:CAS/archive
# RCLONE_CONFIG=/config/rclone/rclone.conf

# --- Supabase (optional, Phase 5+) ---
# (see Auth section above for VITE_* and service role keys)

# --- Web (apps/web) ---
VITE_API_BASE_URL=/api

# --- Staging public URL (Coolify / sslip.io) ---
# See deploy/staging.env.example — display name: Creator AI Studio
# PUBLIC_STAGING_URL=https://creator-ai-studio.217.76.56.66.sslip.io

# --- Production worker ---
WORKER_POLL_INTERVAL_MS=5000
API_BASE_URL=http://api:3000/api

# --- Redis (optional, for BullMQ) ---
# REDIS_URL=redis://redis:6379

# --- Google Drive archive (rclone) ---
# RCLONE_REMOTE=gdrive:CAS/archive
# RCLONE_CONFIG=/config/rclone/rclone.conf
# Mount rclone.conf into the API container at /config/rclone/

# --- Piper TTS (optional, CPU — alternative to ElevenLabs) ---
# PIPER_BIN=/usr/local/bin/piper
# PIPER_MODEL=/models/es_ES-davefx-medium.onnx
