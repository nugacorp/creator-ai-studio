# Creator AI Studio — environment example
# Copy to .env and fill in local values. Do NOT commit real secrets.

# --- API (apps/api) ---
API_PORT=3000
API_HOST=0.0.0.0
LOCAL_STORAGE_PATH=/data/episodes

# --- Auth (optional) ---
# CAS_API_KEY=your-secret-api-key
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Secrets encryption (required for UI API key storage) ---
# CAS_SECRETS_KEY=your-32-char-minimum-master-key-for-encrypting-stored-keys

# --- AI Providers (at least one recommended) ---
AI_PROVIDER_DEFAULT=gemini
# AI_SCRIPT_PROVIDER=openai
# AI_IMAGE_PROVIDER=gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Google OAuth (Gemini + YouTube desde Configuración) ---
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# CAS_PUBLIC_URL=https://creator-ai-studio.217.76.56.66.sslip.io

# --- External Integrations (optional) ---
# YOUTUBE_CLIENT_ID=
# YOUTUBE_ACCESS_TOKEN=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# WEBHOOK_URL=https://your-webhook.example.com/events

# --- Supabase (optional, Phase 5+) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Web (apps/web) ---
VITE_API_BASE_URL=/api

# --- Staging public URL (Coolify / sslip.io) ---
# See deploy/staging.env.example — display name: Creator AI Studio
# PUBLIC_STAGING_URL=https://creator-ai-studio.217.76.56.66.sslip.io

# --- Production worker ---
WORKER_POLL_INTERVAL_MS=5000
API_BASE_URL=http://api:3000/api

# --- Redis (optional, for BullMQ) ---
# REDIS_URL=redis://redis:6379

# --- Google Drive archive (rclone) ---
# RCLONE_REMOTE=gdrive:CAS/archive
# RCLONE_CONFIG=/config/rclone/rclone.conf
# Mount rclone.conf into the API container at /config/rclone/

# --- Piper TTS (optional, CPU — alternative to ElevenLabs) ---
# PIPER_BIN=/usr/local/bin/piper
# PIPER_MODEL=/models/es_ES-davefx-medium.onnx
