# Creator AI Studio — environment example
# Copy to .env and fill in local values. Do NOT commit real secrets.

# --- API (apps/api) ---
API_PORT=3000
API_HOST=0.0.0.0
# Filesystem path used by the API to persist episode workspaces.
# In Coolify staging, mount a persistent volume at this path.
LOCAL_STORAGE_PATH=/data/episodes

# --- Web (apps/web) ---
# Base URL the web app uses to reach the API during local development.
VITE_API_BASE_URL=http://localhost:3000

# --- Production worker (workers/production) ---
# Placeholder polling interval (milliseconds) for the worker loop.
WORKER_POLL_INTERVAL_MS=5000
