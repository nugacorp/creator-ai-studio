# Creator AI Studio — Optional staging worker image
# The worker is a placeholder process in the current MVP and is optional in Coolify.

FROM node:22-bookworm-slim AS builder

WORKDIR /app
ENV NODE_ENV=development

COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY workers/production/package.json workers/production/package.json

RUN npm ci

COPY workers/production workers/production

RUN npm run build --workspace @creator-ai-studio/production-worker

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV LOCAL_STORAGE_PATH=/data/episodes

COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/workers/production/package.json workers/production/package.json
COPY --from=builder /app/workers/production/dist workers/production/dist

RUN mkdir -p /data/episodes

CMD ["npm", "run", "start", "--workspace", "@creator-ai-studio/production-worker"]
