# Staging public URL (Coolify + sslip.io) — use HTTPS after enabling SSL in Coolify
# Display name: Creator AI Studio
PUBLIC_STAGING_URL=https://creator-ai-studio.217.76.56.66.sslip.io
CAS_PUBLIC_URL=https://creator-ai-studio.217.76.56.66.sslip.io
STAGING_FQDN=creator-ai-studio.217.76.56.66.sslip.io
STAGING_IP=217.76.56.66

# FASE 8 — production/staging: real providers only (never enable mocks here)
ALLOW_MOCKS=false
AI_ALLOW_DEMO_FALLBACK=false

# Required for encrypted API key / OAuth storage from Settings UI (32+ chars)
# CAS_SECRETS_KEY=change-me-to-a-long-random-string
# Keep CAS_SECRETS_KEY stable across redeploys — changing it invalidates stored OAuth tokens.

# Google / YouTube OAuth (Settings → Integraciones, or server env)
# Create OAuth 2.0 Client (Web) in Google Cloud Console.
# Authorized redirect URI (staging):
#   https://creator-ai-studio.217.76.56.66.sslip.io/api/oauth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=              # alias for the same Google OAuth client
# YOUTUBE_CLIENT_SECRET=

# Persistent data (docker-compose mounts creator-ai-studio-staging-data:/data)
# CAS_DATA_PATH=/data
# LOCAL_STORAGE_PATH=/data/episodes
# OAuth tokens are stored encrypted at /data/settings/.secrets/secrets.enc

# Gemini / Imagen (image generation) — set in Coolify or inject into runtime compose
# GEMINI_API_KEY=                 # Google AI Studio API key (or save via Settings UI)
# GEMINI_IMAGE_MODEL=imagen-4.0-fast-generate-001   # Imagen 4 Fast (default)
# GEMINI_IMAGE_MODEL=imagen-4.0-generate-001         # Imagen 4 Pro
# GEMINI_NATIVE_IMAGE_MODEL=gemini-3.1-flash-image   # Native Gemini image (fallback path)
# AI_IMAGE_PROVIDER=gemini

# API auth — required in production/staging (NODE_ENV=production)
# CAS_API_KEY=                    # Worker + optional machine-to-machine Bearer
# Set at least one of CAS_API_KEY and/or Supabase vars below.

# TTS — configure at least one for real narration (Settings → ElevenLabs or Piper)
# ELEVENLABS_API_KEY=xi-...
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# PIPER_BIN=/usr/local/bin/piper
# PIPER_MODEL=/models/es_ES-davefx-medium.onnx

# Archive to Google Drive (optional — enable in Settings after configuring)
# RCLONE_REMOTE=gdrive:CAS/archive
# RCLONE_CONFIG=/config/rclone/rclone.conf

# Redis / worker (enabled by default in deploy/docker-compose.staging.yml)
# REDIS_URL=redis://redis:6379

# Supabase Auth (project: creator-ai-studio)
# Dashboard: https://supabase.com/dashboard/project/iiokqyedkylwhonbrrvo
#
# VITE_* are baked at WEB BUILD TIME (deploy/Dockerfile.web). Runtime env on the nginx
# container does NOT enable login — you must rebuild the web image after setting these.
#
# VPS: copy real values to /root/creator-ai-studio/.env.supabase.local (not committed).
# CI:  set GitHub Actions secrets SUPABASE_URL + SUPABASE_ANON_KEY (+ SUPABASE_JWT_SECRET).
# scripts/vps-sync-supabase-env.sh writes the VPS file; vps-redeploy.sh passes build args.
#
SUPABASE_URL=https://iiokqyedkylwhonbrrvo.supabase.co
# SUPABASE_ANON_KEY=              # Required for web login build — Dashboard → API → anon/publishable
# VITE_SUPABASE_URL=https://iiokqyedkylwhonbrrvo.supabase.co   # Optional; derived from SUPABASE_URL
# VITE_SUPABASE_ANON_KEY=         # Optional; derived from SUPABASE_ANON_KEY
# SUPABASE_JWT_SECRET=            # Required for API JWT auth (runtime, API container)
# SUPABASE_SERVICE_ROLE_KEY=      # Optional Postgres sync
