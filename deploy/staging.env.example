# FASE 8 — production/staging: real providers only (never enable mocks here)
ALLOW_MOCKS=false
AI_ALLOW_DEMO_FALLBACK=false

# Required for encrypted API key / OAuth storage from Settings UI (32+ chars)
# CAS_SECRETS_KEY=change-me-to-a-long-random-string

# TTS — configure at least one for real narration (Settings → ElevenLabs or Piper)
# ELEVENLABS_API_KEY=xi-...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# PIPER_BIN=/usr/local/bin/piper
# PIPER_MODEL=/models/es_ES-davefx-medium.onnx

# Archive to Google Drive (optional — enable in Settings after configuring)
# RCLONE_REMOTE=gdrive:CAS/archive
# RCLONE_CONFIG=/config/rclone/rclone.conf

# Redis / worker (enabled by default in docker-compose.staging.yml)
